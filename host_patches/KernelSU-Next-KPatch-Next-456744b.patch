 struct module modules = { 0 };
 static spinlock_t module_lock;
 
+/* Caller holds module_lock. The list is not an RCU walk here. */
+static struct module *find_module_locked(const char *name)
+{
+    struct module *pos;
+
+    list_for_each_entry(pos, &modules.list, list)
+    {
+        if (!strcmp(name, pos->info.name)) return pos;
+    }
+    return 0;
+}
+
+static void module_put_active(struct module *mod)
+{
+    unsigned long flags;
+    flags = spin_lock_irqsave(&module_lock);
+    if (mod && mod->ctl_active > 0) mod->ctl_active--;
+    spin_unlock_irqrestore(&module_lock, flags);
+}
+
+static void module_redact_args(struct module *mod)
+{
+    size_t n;
+
+    if (!mod || !mod->args) return;
+    n = strlen(mod->args);
+    memset(mod->args, 0, n);
+}
+
+/* A required import in SecDebug: no export means the loader rejects the KPM
+ * before INIT (including the unsupported independent LKM loader).
+ * Never advertise a safe contract when an essential kernel primitive is absent.
+ */
+unsigned long secdebug_host_contract_v1(void)
+{
+    if (!kfunc(synchronize_rcu) || !kfunc(__rcu_read_lock) ||
+        !kfunc(__rcu_read_unlock) || !kfunc(_raw_spin_lock_irqsave) ||
+        !kfunc(_raw_spin_unlock_irqrestore))
+        return 0;
+    return 0x53440101UL;
+}
+KP_EXPORT_SYMBOL(secdebug_host_contract_v1);
+
